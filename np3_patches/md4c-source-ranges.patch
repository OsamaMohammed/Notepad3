+/* NP3: report input ranges even when MD4C synthesizes whitespace or NUL
+ * replacements. Integer address checks avoid comparing unrelated pointers. */
+static int
+md_source_text(MD_CTX* ctx, MD_TEXTTYPE type, const CHAR* text, SZ size, void* userdata)
+{
+    OFF begin = ctx->source_begin;
+    OFF end = ctx->source_end;
+    size_t p = (size_t) text;
+    size_t base = (size_t) ctx->text;
+    if(p >= base && p - base <= ctx->size && size <= ctx->size - (p - base)) {
+        begin = (OFF)(p - base);
+        end = begin + size;
+    }
+    if(ctx->parser.source_range != NULL)
+        ctx->parser.source_range(begin, end, userdata);
+    return ctx->parser.text(type, text, size, userdata);
+}
